<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="merge_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        
                    </div>
                </t>
            </t>
        </t>
    </template>
    <record id="action_report_merge_pdf" model="ir.actions.report">
        <field name="name">Name</field>
        <field name="model">merge.pdf</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">merge_pdf.merge_pdf</field>
        <field name="report_file">merge_pdf.merge_pdf</field>
        <field name="print_report_name">'%s' % object.name</field>
        <field name="binding_model_id" ref="model_merge.pdf"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
